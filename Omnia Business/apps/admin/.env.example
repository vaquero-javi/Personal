# Panel del equipo de Omnia (apps/admin, puerto 3300).
# Local: la misma base embebida que la web (npm run db:dev).
# Producción: la cadena del pooler con el rol omnia_admin (NO la de la web, omnia_api).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
DATABASE_POOL_MAX=1

# Firma de la cookie de sesión del panel. 32+ caracteres: openssl rand -base64 32
ADMIN_SESSION_SECRET=
