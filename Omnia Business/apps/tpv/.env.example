# Misma base de datos que el backoffice (apps/web).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
DATABASE_POOL_MAX=1
# Firma de la sesión del camarero (cookie). Obligatoria en producción: 32+ caracteres aleatorios.
POS_SESSION_SECRET=
# Bloqueo automático por inactividad, en minutos.
POS_IDLE_LOCK_MINUTES=10
