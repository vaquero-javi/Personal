# Conexión del backend: rol omnia_api (sin BYPASSRLS) a través del pooler en modo transacción.
DATABASE_URL=postgres://omnia_api.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=10

# Verificación de JWT (Supabase Auth por defecto; en enterprise, cualquier IdP OIDC).
AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Inicio de sesión (fuera de AUTH_MODE=dev): Supabase Auth.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key del proyecto>
APP_URL=http://localhost:3100

# Lectura de albaranes y facturas de proveedor con foto o PDF
# (Almacén › Registrar albarán y Compras › Facturas recibidas › Registrar factura).
# Basta con una de las dos claves; si están las dos, se usa Claude.
# Sin ninguna, la opción aparece desactivada y se registran a mano.
# Gemini (Google) tiene plan gratuito con límite diario; en ese plan Google puede usar lo enviado para mejorar sus productos.
# GEMINI_API_KEY=<clave de Google AI Studio: aistudio.google.com>
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=<clave de la API de Claude>

# QR VeriFactu de las facturas: entorno de pruebas de la AEAT salvo que se indique.
# AEAT_ENTORNO=produccion

# Logs estructurados (JSON por línea): debug | info | warn | error. Por defecto, info.
# LOG_LEVEL=info

# Tarjetas de empleado (Apple/Google Wallet). Ver docs/arquitectura.md §10.
# Obligatoria y la MISMA en apps/web y apps/tpv: openssl rand -base64 32
STAFF_CARD_SECRET_KEY=
# WALLET_PUBLIC_URL=https://omnia.example
# CRON_SECRET=
# Apple Wallet (Apple Developer Program, certificado «Pass Type ID»)
# APPLE_PASS_TYPE_ID=pass.com.omnia.staff
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_PASS_KEY_PASSPHRASE=
# APPLE_WWDR_PEM=
# Google Wallet (Google Pay & Wallet Console + cuenta de servicio)
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SA_EMAIL=
# GOOGLE_WALLET_SA_KEY=

# Contacto de la landing: ID del formulario de Formspree (formspree.io/f/<ID>).
# Los mensajes del chat de contacto llegan al correo asociado a ese formulario.
NEXT_PUBLIC_FORMSPREE_ID=
